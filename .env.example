APP_NAME=Povești pentru Alexandru
APP_HOST=127.0.0.1
APP_PORT=8090
STORY_DIR=stories
MEDIA_DIR=media
VOICE_DIR=voices
VOICE_MANIFEST=voices/voices.json

# mock | higgs | openai | openai-compatible
TTS_PROVIDER=mock
TTS_TIMEOUT_SECONDS=240

# Higgs TTS 3 servit pe PC-ul de gaming prin SGLang-Omni sau vLLM-Omni
HIGGS_BASE_URL=http://IP-TAILSCALE-PC:8000/v1
HIGGS_API_KEY=
HIGGS_MODEL=bosonai/higgs-tts-3-4b
# Profilurile locale aleg mostra; API-ul oficial folosește implicit voice=default.
HIGGS_API_VOICE=default
HIGGS_RESPONSE_FORMAT=wav
HIGGS_TEMPERATURE=0.8
# Gol = dezactivat. Poate fi folosit împreună cu top_k dacă serverul îl acceptă.
HIGGS_TOP_P=
HIGGS_TOP_K=50
HIGGS_MAX_NEW_TOKENS=2048
# Gol = rezultat variabil. Completează un număr pentru reproducibilitate.
HIGGS_SEED=
# true blochează randarea dacă lipsește un fișier vocal de referință.
HIGGS_REQUIRE_REFERENCES=true

# OpenAI, păstrat ca alternativă
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_BASE_URL=

# Alt motor local OpenAI-compatible
LOCAL_TTS_BASE_URL=http://IP-TAILSCALE-PC:8000/v1
LOCAL_TTS_API_KEY=
LOCAL_TTS_MODEL=tts-local

# disabled | openai | openai-compatible
LLM_PROVIDER=disabled
STORY_LLM_MODEL=gpt-5-mini
LLM_BASE_URL=http://IP-TAILSCALE-PC:8000/v1
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=240
